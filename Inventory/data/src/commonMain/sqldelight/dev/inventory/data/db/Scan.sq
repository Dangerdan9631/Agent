CREATE TABLE scan (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    volume_id INTEGER NOT NULL REFERENCES volume(id) ON DELETE CASCADE,
    started_at INTEGER NOT NULL,
    finished_at INTEGER,
    status TEXT NOT NULL,
    file_count INTEGER NOT NULL DEFAULT 0,
    byte_count INTEGER NOT NULL DEFAULT 0,
    new_count INTEGER NOT NULL DEFAULT 0,
    changed_count INTEGER NOT NULL DEFAULT 0,
    missing_count INTEGER NOT NULL DEFAULT 0,
    error TEXT
);

CREATE INDEX scan_volume_idx ON scan(volume_id, started_at DESC);

insertScan:
INSERT INTO scan(volume_id, started_at, status) VALUES (?, ?, 'RUNNING');

lastInsertedId:
SELECT last_insert_rowid();

finishScan:
UPDATE scan SET finished_at = ?, status = ?, file_count = ?, byte_count = ?, new_count = ?, changed_count = ?, missing_count = ?, error = ?
WHERE id = ?;

selectForVolume:
SELECT * FROM scan WHERE volume_id = ? ORDER BY started_at DESC;

selectLatestForVolume:
SELECT * FROM scan WHERE volume_id = ? ORDER BY started_at DESC LIMIT 1;
