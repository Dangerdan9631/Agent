{
  "name": "@starcruisestudios/atlas-cli",
  "version": "0.1.0",
  "description": "A language-neutral architecture analyzer and interactive viewer.",
  "private": true,
  "type": "module",
  "bin": {
    "atlas-cli": "./dist/presentation/cli/atlas-cli.js"
  },
  "exports": {
    "./composition": "./dist/composition/AtlasCompositionRoot.js",
    "./artifact-host": "./dist/composition/AtlasArtifactHost.js",
    "./artifact-host-options": "./dist/composition/AtlasArtifactHostOptions.js",
    "./schema": "./dist/config/atlas.schema.json",
    "./schema/module": "./dist/config/atlas-module.schema.json",
    "./schema/workspace": "./dist/config/atlas-workspace.schema.json"
  },
  "imports": {
    "#application/*": "./dist/application/*",
    "#composition/*": "./dist/composition/*",
    "#infrastructure/*": "./dist/infrastructure/*",
    "#presentation/*": "./dist/presentation/*"
  },
  "files": [
    "dist",
    "DOC.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server",
    "build:server": "tsc -p tsconfig.build.json && node ./scripts/CopyBuildAssets.mjs",
    "link": "npm link",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "atlas:generate-models": "node ./dist/presentation/cli/atlas-cli.js generate-models --no-validate"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^14.0.3",
    "cytoscape": "^3.33.1",
    "dependency-cruiser": "^17.4.3",
    "fast-glob": "^3.3.3",
    "minimatch": "^10.2.5",
    "tslog": "^4.11.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
