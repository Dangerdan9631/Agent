{
  "name": "@starcruisestudios/atlas",
  "version": "0.1.0",
  "description": "Electron host for Atlas's generated architecture viewer.",
  "private": true,
  "type": "module",
  "main": "./dist/main/main/AtlasDesktopMain.js",
  "imports": {
    "#main/*": "./dist/main/main/*"
  },
  "bin": {
    "atlas": "./scripts/AtlasElectronLauncher.mjs"
  },
  "scripts": {
    "build": "npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests --configLoader runner",
    "start": "electron ."
  },
  "dependencies": {
    "@starcruisestudios/atlas-cli": "file:../atlas-cli"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^39.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}

