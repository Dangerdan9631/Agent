{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "outDir": "./dist/main",
    "rootDir": "./src",
    "types": ["node", "electron"],
    "paths": {
      "#main/*": ["dist/main/main/*"]
    }
  },
  "include": ["src/preload/**/*.ts"]
}
