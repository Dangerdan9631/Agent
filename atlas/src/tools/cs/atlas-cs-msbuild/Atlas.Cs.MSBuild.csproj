<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>StarCruiseStudios.Atlas.Cs.MSBuild</PackageId>
    <Description>Opt-in MSBuild targets for Atlas C# architecture generation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="DOC.md" Pack="true" PackagePath="README.md" />
    <None Include="build/StarCruiseStudios.Atlas.Cs.MSBuild.targets" Pack="true" PackagePath="build/StarCruiseStudios.Atlas.Cs.MSBuild.targets" />
  </ItemGroup>
</Project>
