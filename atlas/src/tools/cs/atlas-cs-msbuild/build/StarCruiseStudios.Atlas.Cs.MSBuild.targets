<Project>
  <PropertyGroup>
    <AtlasCsCommand Condition="'$(AtlasCsCommand)' == ''">atlas-cs</AtlasCsCommand>
    <AtlasGenerateOnBuild Condition="'$(AtlasGenerateOnBuild)' == ''">true</AtlasGenerateOnBuild>
  </PropertyGroup>

  <Target Name="AtlasGenerateModuleModel"
          AfterTargets="Build"
          Condition="'$(AtlasGenerateOnBuild)' == 'true' and '$(TargetFramework)' != ''">
    <Error Condition="'$(AtlasRootDirectory)' == ''"
           Text="AtlasRootDirectory is required and must identify the shared Atlas artifact root." />
    <Exec Command="&quot;$(AtlasCsCommand)&quot; $(AtlasCsCommandArguments) generate --project &quot;$(MSBuildProjectFullPath)&quot; --target-framework &quot;$(TargetFramework)&quot; --output &quot;$(AtlasRootDirectory)&quot;" />
  </Target>
</Project>
