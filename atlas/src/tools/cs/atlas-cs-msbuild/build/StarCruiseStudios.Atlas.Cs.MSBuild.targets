<Project>
  <PropertyGroup>
    <AtlasCsCommand Condition="'$(AtlasCsCommand)' == ''">atlas-cs</AtlasCsCommand>
    <AtlasGenerateOnBuild Condition="'$(AtlasGenerateOnBuild)' == ''">true</AtlasGenerateOnBuild>
  </PropertyGroup>

  <Target Name="AtlasGenerateModuleModel"
          AfterTargets="Build"
          Condition="'$(AtlasGenerateOnBuild)' == 'true' and '$(TargetFramework)' != ''">
    <Error Condition="'$(AtlasModelFile)' == ''"
           Text="AtlasModelFile is required and must identify this target framework's .atlas.module.yml output." />
    <Error Condition="'$(TargetFrameworks)' != '' and !$([System.String]::Copy('$(AtlasModelFile)').Contains('$(TargetFramework)'))"
           Text="A multi-target project AtlasModelFile must include TargetFramework or another target-unique value." />
    <Exec Command="&quot;$(AtlasCsCommand)&quot; $(AtlasCsCommandArguments) generate --project &quot;$(MSBuildProjectFullPath)&quot; --target-framework &quot;$(TargetFramework)&quot; --model-file &quot;$(AtlasModelFile)&quot;" />
  </Target>
</Project>
