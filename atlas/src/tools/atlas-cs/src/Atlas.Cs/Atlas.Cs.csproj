<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>atlas-cs</AssemblyName>
    <RootNamespace>StarCruiseStudios.Atlas.Cs</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>atlas-cs</ToolCommandName>
    <PackageId>StarCruiseStudios.Atlas.Cs</PackageId>
    <Description>Compiler-backed C# source-model generator for Atlas.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../DOC.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../../atlas-cli/src/config/atlas.schema.json" Link="schemas/atlas.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../atlas-cli/src/config/atlas-module.schema.json" Link="schemas/atlas-module.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../atlas-cli/src/config/atlas-workspace.schema.json" Link="schemas/atlas-workspace.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
