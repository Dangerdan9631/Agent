{
  "name": "@starcruisestudios/atlas-ts-cli",
  "version": "0.1.0",
  "description": "TypeScript source-model generator for Atlas.",
  "private": true,
  "type": "module",
  "bin": {
    "atlas-ts": "./dist/presentation/AtlasTypeScriptCliMain.js"
  },
  "exports": {
    ".": "./dist/presentation/AtlasTypeScriptCliMain.js"
  },
  "imports": {
    "#application/*": "./dist/application/*",
    "#presentation/*": "./dist/presentation/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "link": "npm link",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests --configLoader runner"
  },
  "dependencies": {
    "@starcruisestudios/atlas-ts-sdk": "file:../atlas-ts-sdk",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "tslog": "^4.11.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
