# frozen_string_literal: true

require "fileutils"
require "rake/testtask"

# Names of the canonical Atlas contracts packaged with the Ruby gem.
# The list is also used to verify package parity during tests and builds.
SCHEMA_NAMES = %w[atlas.schema.json atlas-module.schema.json].freeze

desc "Copy the canonical Atlas schemas into the Ruby gem package"
task :prepare_schemas do
  schema_source = File.expand_path("../../atlas-cli/src/config", __dir__)
  schema_target = File.expand_path("atlas-rb-cli/schemas", __dir__)
  FileUtils.mkdir_p(schema_target)
  SCHEMA_NAMES.each { |name| FileUtils.cp(File.join(schema_source, name), File.join(schema_target, name)) }
end

Rake::TestTask.new(test: :prepare_schemas) do |task|
  task.libs << "atlas-rb-sdk/lib"
  task.libs << "atlas-rb-cli/lib"
  task.libs << "atlas-rb-rake/lib"
  task.libs << "test"
  task.pattern = "test/**/*_test.rb"
end

desc "Build the Ruby SDK, CLI, and Rake integration gems"
task build: :prepare_schemas do
  Dir.chdir("atlas-rb-sdk") { sh "gem build atlas-rb-sdk.gemspec" }
  Dir.chdir("atlas-rb-cli") { sh "gem build atlas-rb-cli.gemspec" }
  Dir.chdir("atlas-rb-rake") { sh "gem build atlas-rb-rake.gemspec" }
end
task default: :test
