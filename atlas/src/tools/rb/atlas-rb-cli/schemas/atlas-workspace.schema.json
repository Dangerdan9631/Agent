{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.dev/schema/atlas-workspace.schema.json",
  "title": "Atlas Workspace Manifest",
  "description": "Selects independently generated Atlas module models for one federated workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modules"],
  "properties": {
    "schemaVersion": {
      "description": "Identifies the supported independently versioned manifest schema.",
      "const": 1
    },
    "modules": {
      "description": "Lists selected module models in artifact identity order.",
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "description": "Locates one model and asserts its artifact identity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "modelPath"],
      "properties": {
        "moduleId": {
          "description": "Expected opaque artifact ID.",
          "type": "string",
          "minLength": 1
        },
        "modelPath": {
          "description": "Manifest-relative model file path.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    }
  }
}
