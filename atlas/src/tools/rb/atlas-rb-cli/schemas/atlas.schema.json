{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.dev/schema/atlas.schema.json",
  "title": "Atlas Project Configuration",
  "description": "Defines the single version-two Atlas project root and its closed configuration fragments.",
  "$ref": "#/$defs/rootDocument",
  "$defs": {
    "text": {
      "description": "A trimmed non-empty string.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:.|\\n)*\\S$|^\\S$"
    },
    "path": {
      "description": "A slash-normalized relative path without parent traversal.",
      "allOf": [
        { "$ref": "#/$defs/text" },
        {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"
        }
      ]
    },
    "pathPattern": {
      "description": "A portable slash-normalized Atlas path pattern.",
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*[{}!()\\[\\]]).+$" }
      ]
    },
    "modulePath": {
      "description": "A normalized module-relative source path without dot segments.",
      "allOf": [
        { "$ref": "#/$defs/path" },
        {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        }
      ]
    },
    "idPattern": {
      "description": "A complete opaque ID pattern supporting only star and question-mark wildcards.",
      "allOf": [
        { "$ref": "#/$defs/text" },
        { "type": "string", "pattern": "^(?!.*[{}!()\\[\\]]).+$" }
      ]
    },
    "uniqueTexts": {
      "description": "A non-empty collection of unique non-empty strings.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "rootDocument": {
      "description": "The single project-root configuration document.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "documentType", "project", "modules"],
      "properties": {
        "schemaVersion": { "description": "Identifies version two.", "const": 2 },
        "documentType": { "description": "Identifies the root document family.", "const": "root" },
        "extends": {
          "description": "Lists unique base fragments in merge order.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/path" },
              { "type": "string", "pattern": "\\.atlas\\.base\\.yml$" }
            ]
          }
        },
        "project": { "$ref": "#/$defs/projectConfiguration" },
        "modules": {
          "description": "Lists complete module entries in processing order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "allOf": [
                  { "$ref": "#/$defs/path" },
                  { "type": "string", "pattern": "atlas\\.module\\.config\\.yml$" }
                ]
              },
              { "$ref": "#/$defs/moduleConfiguration" }
            ]
          }
        },
        "validation": { "$ref": "#/$defs/rootValidation" }
      }
    },
    "baseDocument": {
      "description": "A reusable external-dependency diagram-default fragment.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "documentType", "diagramDefaults"],
      "properties": {
        "schemaVersion": { "description": "Identifies version two.", "const": 2 },
        "documentType": { "description": "Identifies the base fragment family.", "const": "base" },
        "diagramDefaults": { "$ref": "#/$defs/externalDiagramDefaults" }
      }
    },
    "moduleDocument": {
      "description": "A complete portable module configuration fragment.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "documentType", "model"],
      "properties": {
        "schemaVersion": { "description": "Identifies version two.", "const": 2 },
        "documentType": {
          "description": "Identifies the module fragment family.",
          "const": "module"
        },
        "model": {
          "allOf": [
            { "$ref": "#/$defs/path" },
            { "type": "string", "pattern": "\\.atlas\\.module\\.yml$" }
          ]
        },
        "tags": {
          "description": "Lists unique project-policy tags.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "diagrams": {
          "description": "Declares explicit module diagrams.",
          "type": "array",
          "items": { "$ref": "#/$defs/moduleDiagram" }
        },
        "validation": { "$ref": "#/$defs/moduleValidation" }
      }
    },
    "projectConfiguration": {
      "description": "Defines project identity, artifacts, defaults, and landscape diagrams.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifacts"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "artifacts": {
          "description": "Defines project-level generated artifact placement.",
          "type": "object",
          "additionalProperties": false,
          "required": ["root"],
          "properties": { "root": { "$ref": "#/$defs/path" } }
        },
        "diagramDefaults": { "$ref": "#/$defs/externalDiagramDefaults" },
        "diagrams": {
          "description": "Declares explicit project diagrams.",
          "type": "array",
          "items": { "$ref": "#/$defs/projectDiagram" }
        }
      }
    },
    "moduleConfiguration": {
      "description": "Defines one generated model and all module-owned project policy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": {
          "allOf": [
            { "$ref": "#/$defs/path" },
            { "type": "string", "pattern": "\\.atlas\\.module\\.yml$" }
          ]
        },
        "tags": {
          "description": "Lists unique project-policy tags.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "diagrams": {
          "description": "Declares explicit module diagrams.",
          "type": "array",
          "items": { "$ref": "#/$defs/moduleDiagram" }
        },
        "validation": { "$ref": "#/$defs/moduleValidation" }
      }
    },
    "externalDiagramDefaults": {
      "description": "Defines the only external dependency behavior shared between diagrams.",
      "type": "object",
      "additionalProperties": false,
      "required": ["externalDependencies"],
      "properties": {
        "externalDependencies": { "$ref": "#/$defs/externalDependencyDefaults" }
      }
    },
    "externalDependencyDefaults": {
      "description": "Defines inheritable external exclusion and collapse behavior.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excludeIds": {
          "description": "Lists unique external ID exclusion patterns.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/idPattern" }
        },
        "collapse": { "$ref": "#/$defs/collapse" }
      }
    },
    "collapse": {
      "description": "Controls external identity collapsing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "description": "Selects collapsing behavior.",
          "enum": ["all", "matching", "none"]
        },
        "ids": {
          "description": "Lists ID patterns selected by matching mode.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/idPattern" }
        }
      }
    },
    "commonDiagramProperties": {
      "description": "Defines fields shared by every diagram.",
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "inheritDefaults": {
          "description": "Controls inherited external defaults.",
          "type": "boolean"
        },
        "layout": { "$ref": "#/$defs/layout" },
        "filters": { "$ref": "#/$defs/filters" },
        "externalDependencies": { "$ref": "#/$defs/externalDependencyOptions" }
      }
    },
    "projectDiagram": {
      "description": "Defines one project landscape diagram.",
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/commonDiagramProperties" },
        {
          "type": "object",
          "properties": {
            "groups": {
              "description": "Lists non-overlapping module groups.",
              "type": "array",
              "items": { "$ref": "#/$defs/projectGroup" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "moduleDiagram": {
      "description": "Defines one module-owned diagram.",
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/commonDiagramProperties" },
        {
          "type": "object",
          "required": ["scope"],
          "properties": { "scope": { "$ref": "#/$defs/moduleScope" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "moduleScope": {
      "description": "Selects a complete module or source-path subtree.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "description": "Selects the complete module.", "const": "module" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "description": "Selects a source path.", "const": "path" },
            "path": { "$ref": "#/$defs/modulePath" }
          }
        }
      ]
    },
    "projectGroup": {
      "description": "Defines one project-diagram module group.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "selector"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "selector": { "$ref": "#/$defs/moduleSelector" }
      }
    },
    "layout": {
      "description": "Defines diagram-local deterministic layout behavior.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "description": "Selects the primary placement axis.",
          "enum": ["horizontal", "vertical"]
        },
        "rows": { "description": "Defines a positive row limit.", "type": "integer", "minimum": 1 },
        "horizontalGap": {
          "description": "Defines a non-negative finite horizontal gap.",
          "type": "number",
          "minimum": 0
        },
        "verticalGap": {
          "description": "Defines a non-negative finite vertical gap.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "filters": {
      "description": "Defines diagram-local presentation filters.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elementKinds": { "$ref": "#/$defs/elementKinds" },
        "visibilities": { "$ref": "#/$defs/visibilities" },
        "traits": { "$ref": "#/$defs/uniqueTexts" },
        "relationshipKinds": { "$ref": "#/$defs/relationshipKinds" },
        "excludeSourcePaths": {
          "description": "Lists unique source-path exclusion patterns.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathPattern" }
        }
      }
    },
    "externalDependencyOptions": {
      "description": "Defines diagram-local external dependency behavior.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excludeIds": {
          "description": "Lists unique external ID exclusion patterns.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/idPattern" }
        },
        "collapse": { "$ref": "#/$defs/collapse" },
        "splitByModule": {
          "description": "Splits collapsed targets by importing module.",
          "type": "boolean"
        }
      }
    },
    "moduleSelector": {
      "description": "Selects loaded modules by ID pattern and configured tag.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "moduleIds": {
          "description": "Lists unique complete module ID patterns.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/idPattern" }
        },
        "moduleTags": { "$ref": "#/$defs/uniqueTexts" }
      }
    },
    "elementSelector": {
      "description": "Selects elements inside one loaded module.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "elementKinds": { "$ref": "#/$defs/elementKinds" },
        "visibilities": { "$ref": "#/$defs/visibilities" },
        "traits": { "$ref": "#/$defs/uniqueTexts" },
        "sourcePaths": {
          "description": "Lists unique module-relative source path patterns.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathPattern" }
        }
      }
    },
    "rootValidation": {
      "description": "Defines rules evaluated between loaded modules.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "description": "Lists root validation rules.",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/rootCircularRule" },
              { "$ref": "#/$defs/rootDirectionRule" }
            ]
          }
        }
      }
    },
    "moduleValidation": {
      "description": "Defines rules evaluated from one owning module.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "description": "Lists module validation rules.",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/moduleCircularRule" },
              { "$ref": "#/$defs/moduleDirectionRule" },
              { "$ref": "#/$defs/forbidRule" }
            ]
          }
        }
      }
    },
    "ruleFields": {
      "description": "Defines fields shared by validation rules.",
      "type": "object",
      "required": ["id", "type", "severity", "relationships"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "type": { "$ref": "#/$defs/text" },
        "severity": {
          "description": "Determines validation outcome.",
          "enum": ["error", "warning"]
        },
        "relationships": { "$ref": "#/$defs/relationshipKinds" }
      }
    },
    "rootCircularRule": {
      "description": "Rejects cycles between selected loaded modules.",
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/ruleFields" },
        {
          "type": "object",
          "properties": {
            "type": { "description": "Identifies cycle prohibition.", "const": "no-circular" },
            "within": { "$ref": "#/$defs/moduleSelector" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rootDirectionRule": {
      "description": "Restricts dependencies between selected loaded modules.",
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/ruleFields" },
        {
          "type": "object",
          "required": ["mode", "from", "to"],
          "properties": {
            "type": {
              "description": "Identifies directional dependency behavior.",
              "const": "dependency-direction"
            },
            "mode": {
              "description": "Selects allow-only or forbidden targets.",
              "enum": ["allow-only", "forbid"]
            },
            "from": { "$ref": "#/$defs/moduleSelector" },
            "to": { "$ref": "#/$defs/moduleSelector" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "moduleCircularRule": {
      "description": "Rejects cycles among selected elements in one module.",
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/ruleFields" },
        {
          "type": "object",
          "properties": {
            "type": { "description": "Identifies cycle prohibition.", "const": "no-circular" },
            "within": { "$ref": "#/$defs/elementSelector" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "moduleDirectionRule": {
      "description": "Restricts dependencies among selected elements in one module.",
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/ruleFields" },
        {
          "type": "object",
          "required": ["mode", "from", "to"],
          "properties": {
            "type": {
              "description": "Identifies directional dependency behavior.",
              "const": "dependency-direction"
            },
            "mode": {
              "description": "Selects allow-only or forbidden targets.",
              "enum": ["allow-only", "forbid"]
            },
            "from": { "$ref": "#/$defs/elementSelector" },
            "to": { "$ref": "#/$defs/elementSelector" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "forbidRule": {
      "description": "Rejects selected local, module, or external targets.",
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/ruleFields" },
        {
          "type": "object",
          "required": ["to"],
          "properties": {
            "type": { "description": "Identifies target prohibition behavior.", "const": "forbid" },
            "from": { "$ref": "#/$defs/elementSelector" },
            "to": {
              "description": "Selects exactly one target family.",
              "oneOf": [
                { "$ref": "#/$defs/moduleSelector" },
                { "$ref": "#/$defs/elementSelector" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["externalIds"],
                  "properties": {
                    "externalIds": {
                      "description": "Lists unique external target ID patterns.",
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "$ref": "#/$defs/idPattern" }
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "elementKinds": {
      "description": "Lists unique normalized source element kinds.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "namespace",
          "source-unit",
          "class",
          "interface",
          "struct",
          "record",
          "enum",
          "annotation",
          "delegate",
          "type-alias",
          "function",
          "local-function",
          "constructor",
          "method",
          "property",
          "field",
          "constant",
          "event",
          "enum-member",
          "parameter",
          "local-variable",
          "type-parameter"
        ]
      }
    },
    "visibilities": {
      "description": "Lists unique normalized visibility values.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["public", "protected", "internal", "private", "local", "unknown"] }
    },
    "relationshipKinds": {
      "description": "Lists unique normalized semantic relationship kinds.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "imports",
          "exports",
          "references",
          "inherits",
          "implements",
          "calls",
          "instantiates",
          "reads",
          "writes",
          "overrides",
          "decorates"
        ]
      }
    }
  }
}
