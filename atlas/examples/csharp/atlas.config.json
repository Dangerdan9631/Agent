{
  "schemaVersion": 1,
  "discovery": {
    "packageGlobs": ["src/*"],
    "excludePackageGlobs": ["verification", "build"],
    "defaultSourceRoots": ["."],
    "packages": [
      {
        "match": { "name": "Atlas.Example.Domain@*" },
        "classification": "runtime",
        "classes": ["core", "domain"]
      },
      {
        "match": { "name": "Atlas.Example.Application@*" },
        "classification": "runtime",
        "classes": ["core", "use-case"]
      },
      {
        "match": { "name": "Atlas.Example.Infrastructure@*" },
        "classification": "runtime",
        "classes": ["adapter"]
      },
      {
        "match": { "name": "Atlas.Example.App@*" },
        "classification": "runtime",
        "classes": ["delivery"]
      }
    ]
  },
  "artifacts": { "root": "architecture" },
  "layout": {
    "orientation": "horizontal",
    "rows": 4,
    "horizontalGap": 140,
    "verticalGap": 110
  },
  "diagrams": {
    "moduleGroups": [
      {
        "id": "csharp-catalog-core",
        "title": "C# catalog core",
        "moduleIdPatterns": ["Atlas.Example.Domain@*", "Atlas.Example.Application@*"]
      },
      {
        "id": "csharp-catalog-adapters",
        "title": "C# catalog adapters",
        "moduleIdPatterns": ["Atlas.Example.Infrastructure@*", "Atlas.Example.App@*"]
      }
    ],
    "excludeSourceGlobs": ["**/*.AssemblyInfo.cs"],
    "excludeExternalDependencies": ["System.Runtime.*"],
    "collapseExternalDependencies": false,
    "collapseExternalDependencyGlobs": ["System.Text.Json.*"],
    "splitExternalDependenciesByImporter": false,
    "externalDependencyImporterSplits": [
      {
        "dependency": "System.Collections.Generic.*",
        "packageNames": ["Atlas.Example.Application@net8.0", "Atlas.Example.Infrastructure@net8.0"]
      }
    ],
    "packages": [
      {
        "packageName": "Atlas.Example.Domain@net8.0",
        "excludeSourceGlobs": ["**/Internal/**"]
      }
    ],
    "folders": [
      {
        "packageName": "Atlas.Example.Application@net8.0",
        "path": "Catalog",
        "title": "C# application catalog",
        "collapseExternalDependencies": true
      },
      {
        "packageName": "Atlas.Example.Infrastructure@net8.0",
        "path": "Catalog",
        "title": "C# infrastructure catalog",
        "excludeExternalDependencies": ["System.Text.Json.Serialization.*"]
      },
      {
        "packageName": "Atlas.Example.App@net8.0",
        "path": "Composition",
        "title": "C# executable composition",
        "collapseExternalDependencies": true,
        "splitExternalDependenciesByImporter": true
      }
    ]
  },
  "layers": [
    {
      "name": "domain",
      "sourceGlobs": ["Catalog/**"],
      "packageNames": ["Atlas.Example.Domain@net8.0"]
    },
    {
      "name": "application",
      "sourceGlobs": ["Catalog/**"],
      "packageNames": ["Atlas.Example.Application@net8.0"]
    },
    {
      "name": "infrastructure",
      "sourceGlobs": ["Catalog/**", "generated/**"],
      "packageNames": ["Atlas.Example.Infrastructure@net8.0"]
    },
    {
      "name": "delivery",
      "sourceGlobs": ["Composition/**", "Program.cs"],
      "packageNames": ["Atlas.Example.App@net8.0"]
    }
  ],
  "rules": [
    { "id": "no-cycles", "type": "no-circular", "severity": "error" },
    { "id": "runtime-never-depends-on-support", "type": "no-runtime-to-support", "severity": "error" },
    {
      "id": "domain-does-not-depend-on-adapters",
      "type": "dependency-direction",
      "severity": "error",
      "mode": "forbid",
      "from": { "layers": ["domain"] },
      "to": { "packageClasses": ["adapter", "delivery"] }
    },
    {
      "id": "domain-imports-no-outer-layer",
      "type": "forbidden-import",
      "severity": "error",
      "from": { "layers": ["domain"] },
      "patterns": ["Atlas.Example.Infrastructure*", "Atlas.Example.App*"]
    },
    {
      "id": "domain-has-no-json-dependency",
      "type": "forbidden-external",
      "severity": "error",
      "from": { "layers": ["domain"] },
      "packages": ["System.Text.Json*"]
    }
  ]
}
