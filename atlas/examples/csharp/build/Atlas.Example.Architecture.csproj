<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AtlasGenerateOnBuild>true</AtlasGenerateOnBuild>
    <AtlasWorkspace>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))</AtlasWorkspace>
    <AtlasSolution>$(AtlasWorkspace)/Atlas.Example.slnx</AtlasSolution>
    <AtlasArtifactRoot>$(AtlasWorkspace)/architecture</AtlasArtifactRoot>
    <AtlasCsCommand>dotnet</AtlasCsCommand>
    <AtlasCsCommandArguments>&quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../src/tools/atlas-cs/src/Atlas.Cs/bin/$(Configuration)/net8.0/atlas-cs.dll'))&quot;</AtlasCsCommandArguments>
    <AtlasCliCommand>node</AtlasCliCommand>
    <AtlasCliCommandArguments>&quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../src/atlas-cli/dist/presentation/cli/atlas-cli.js'))&quot;</AtlasCliCommandArguments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/App/Atlas.Example.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../verification/Atlas.Example.Verification.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../src/tools/atlas-cs/src/Atlas.Cs/Atlas.Cs.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="../../../src/tools/atlas-cs/src/Atlas.Cs.MSBuild/build/StarCruiseStudios.Atlas.Cs.MSBuild.targets" />
  <Target Name="VerifyAtlasArtifacts" AfterTargets="AtlasGenerateAfterBuild" Condition="'$(AtlasGenerateOnBuild)' == 'true'">
    <Exec Command="dotnet &quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../verification/bin/$(Configuration)/net8.0/Atlas.Example.Verification.dll'))&quot; &quot;$(AtlasArtifactRoot)&quot;" />
  </Target>
</Project>

