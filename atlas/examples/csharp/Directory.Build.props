<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <AtlasGenerateOnBuild>true</AtlasGenerateOnBuild>
    <AtlasRootDirectory>$(MSBuildThisFileDirectory)architecture</AtlasRootDirectory>
    <AtlasCsCommand>dotnet</AtlasCsCommand>
    <AtlasCsCommandArguments>&quot;$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/tools/cs/atlas-cs-cli/bin/$(Configuration)/net8.0/Atlas.Cs.Cli.dll'))&quot;</AtlasCsCommandArguments>
  </PropertyGroup>
</Project>
