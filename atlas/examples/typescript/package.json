{
  "name": "@atlas-example/typescript-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "tsx packages/app/src/main.ts \"The Left Hand of Darkness\"",
    "architecture:models": "atlas-ts-npm --workspace . --config atlas.config.yml --output architecture",
    "architecture:validate": "atlas-cli validate --manifest architecture/models/atlas.manifest.yml",
    "architecture:generate": "atlas-cli generate --manifest architecture/models/atlas.manifest.yml --no-validate",
    "architecture:layout": "atlas-cli layout landscape --manifest architecture/models/atlas.manifest.yml --generate --force",
    "architecture:view": "atlas --config atlas.config.yml --manifest architecture/models/atlas.manifest.yml",
    "architecture:clean": "atlas-cli clean --confirm",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run architecture:models && npm run architecture:validate && npm run architecture:generate"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@starcruisestudios/atlas": "file:../../src/atlas",
    "@starcruisestudios/atlas-cli": "file:../../src/atlas-cli",
    "@starcruisestudios/atlas-ts-cli": "file:../../src/tools/ts/atlas-ts-cli",
    "@starcruisestudios/atlas-ts-npm": "file:../../src/tools/ts/atlas-ts-npm",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
