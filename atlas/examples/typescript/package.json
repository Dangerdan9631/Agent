{
  "name": "@atlas-example/typescript-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "tsx packages/app/src/main.ts",
    "architecture:models": "atlas-ts generate",
    "architecture:validate": "atlas-cli validate",
    "architecture:generate": "atlas-cli generate --no-validate",
    "architecture:view": "atlas atlas.config.json",
    "build": "tsc --noEmit && npm run architecture:models && npm run architecture:validate && npm run architecture:generate"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@starcruisestudios/atlas": "file:../../src/atlas",
    "@starcruisestudios/atlas-cli": "file:../../src/atlas-cli",
    "@starcruisestudios/atlas-ts": "file:../../src/tools/atlas-ts",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
