{
  "schemaVersion": 1,
  "discovery": {
    "packageGlobs": ["*"],
    "excludePackageGlobs": ["*-fixture"],
    "defaultSourceRoots": ["src/main/kotlin"],
    "packages": [
      {
        "match": { "name": "dev.atlas.example:domain:1.0.0" },
        "classification": "runtime",
        "classes": ["core", "domain"]
      },
      {
        "match": { "name": "dev.atlas.example:application:1.0.0" },
        "classification": "runtime",
        "classes": ["core", "use-case"]
      },
      {
        "match": { "name": "dev.atlas.example:infrastructure:1.0.0" },
        "classification": "runtime",
        "classes": ["adapter"]
      },
      {
        "match": { "name": "dev.atlas.example:app:1.0.0" },
        "classification": "runtime",
        "classes": ["delivery"]
      }
    ]
  },
  "artifacts": { "root": "architecture" },
  "layout": {
    "orientation": "horizontal",
    "rows": 4,
    "horizontalGap": 140,
    "verticalGap": 110
  },
  "diagrams": {
    "moduleGroups": [
      {
        "id": "catalog-core",
        "title": "Catalog core",
        "moduleIdPatterns": [
          "dev.atlas.example:domain:*",
          "dev.atlas.example:application:*"
        ]
      },
      {
        "id": "catalog-adapters",
        "title": "Catalog adapters and delivery",
        "moduleIdPatterns": [
          "dev.atlas.example:infrastructure:*",
          "dev.atlas.example:app:*"
        ]
      }
    ],
    "excludeSourceGlobs": ["**/*Generated.kt"],
    "excludeExternalDependencies": ["java.*"],
    "collapseExternalDependencies": false,
    "collapseExternalDependencyGlobs": [
      "com.fasterxml.jackson.*",
      "com.google.common.*"
    ],
    "splitExternalDependenciesByImporter": false,
    "externalDependencyImporterSplits": [
      {
        "dependency": "org.apache.commons.lang3.*",
        "packageNames": [
          "dev.atlas.example:app:1.0.0",
          "dev.atlas.example:infrastructure:1.0.0"
        ]
      }
    ],
    "packages": [
      {
        "packageName": "dev.atlas.example:domain:1.0.0",
        "excludeSourceGlobs": ["**/internal/**"]
      },
      {
        "packageName": "dev.atlas.example:infrastructure:1.0.0",
        "excludeSourceGlobs": ["**/telemetry/**"]
      }
    ],
    "folders": [
      {
        "packageName": "dev.atlas.example:application:1.0.0",
        "path": "src/main/kotlin/dev/atlas/example/application/catalog",
        "title": "Application catalog use cases",
        "collapseExternalDependencies": true,
        "splitExternalDependenciesByImporter": false
      },
      {
        "packageName": "dev.atlas.example:infrastructure:1.0.0",
        "path": "src/main/kotlin/dev/atlas/example/infrastructure/catalog",
        "title": "Catalog infrastructure adapters",
        "excludeSourceGlobs": ["**/telemetry/**"],
        "excludeExternalDependencies": ["com.fasterxml.jackson.*"],
        "collapseExternalDependencies": false,
        "splitExternalDependenciesByImporter": false,
        "externalDependencyImporterSplits": [
          {
            "dependency": "org.apache.commons.lang3.*",
            "packageNames": ["dev.atlas.example:infrastructure:1.0.0"]
          }
        ]
      },
      {
        "packageName": "dev.atlas.example:app:1.0.0",
        "path": "src/main/kotlin/dev/atlas/example/app",
        "title": "Executable composition and delivery",
        "collapseExternalDependencies": true,
        "splitExternalDependenciesByImporter": true
      }
    ]
  },
  "layers": [
    {
      "name": "domain",
      "sourceGlobs": ["src/main/kotlin/dev/atlas/example/domain/**"],
      "packageNames": ["dev.atlas.example:domain:1.0.0"]
    },
    {
      "name": "application",
      "sourceGlobs": ["src/main/kotlin/dev/atlas/example/application/**"],
      "packageNames": ["dev.atlas.example:application:1.0.0"]
    },
    {
      "name": "infrastructure",
      "sourceGlobs": ["src/main/kotlin/dev/atlas/example/infrastructure/**"],
      "packageNames": ["dev.atlas.example:infrastructure:1.0.0"]
    },
    {
      "name": "delivery",
      "sourceGlobs": ["src/main/kotlin/dev/atlas/example/app/**"],
      "packageNames": ["dev.atlas.example:app:1.0.0"]
    }
  ],
  "rules": [
    {
      "id": "no-cycles",
      "type": "no-circular",
      "severity": "error"
    },
    {
      "id": "runtime-never-depends-on-support",
      "type": "no-runtime-to-support",
      "severity": "error"
    },
    {
      "id": "domain-does-not-depend-on-adapters",
      "type": "dependency-direction",
      "severity": "error",
      "mode": "forbid",
      "from": { "layers": ["domain"] },
      "to": { "packageClasses": ["adapter", "delivery"] }
    },
    {
      "id": "domain-imports-no-outer-layer",
      "type": "forbidden-import",
      "severity": "error",
      "from": { "layers": ["domain"] },
      "patterns": [
        "dev.atlas.example.app*",
        "dev.atlas.example.infrastructure*",
        "java.sql*"
      ]
    },
    {
      "id": "domain-has-no-framework-dependencies",
      "type": "forbidden-external",
      "severity": "error",
      "from": { "layers": ["domain"] },
      "packages": [
        "com.fasterxml.jackson.*",
        "com.google.common.*",
        "org.apache.commons.*"
      ]
    }
  ]
}
