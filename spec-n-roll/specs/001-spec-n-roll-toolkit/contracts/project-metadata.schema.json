{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-n-roll.local/contracts/project-metadata.schema.json",
  "title": "Spec-n-Roll Project Metadata",
  "type": "object",
  "required": ["schemaVersion", "nextTaskSpecId", "updatedAt"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "nextTaskSpecId": {
      "type": "integer",
      "minimum": 1,
      "description": "Sequential counter for assigning new task spec numeric IDs. Incremented atomically on each new task spec directory."
    },
    "currentTaskSpecId": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{3,}$"
    },
    "currentTaskSlug": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "implementationStartedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "currentTaskSpecId": { "type": "string" } },
        "required": ["currentTaskSpecId"]
      },
      "then": {
        "required": ["currentTaskSlug"],
        "properties": {
          "currentTaskSlug": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
