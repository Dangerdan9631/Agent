{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-n-roll.local/contracts/extension-manifest.schema.json",
  "title": "Spec-n-Roll Extension Manifest",
  "type": "object",
  "required": ["manifestVersion", "id", "name", "targetToolkitVersion"],
  "properties": {
    "manifestVersion": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "targetToolkitVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stepId", "command", "entrypoint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stepId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Open kebab-case workflow step identifier this extension replaces or augments. Must match a step registered in the merged workflow step registry (built-in, on-demand, or extension-defined)."
          },
          "command": {
            "type": "string",
            "pattern": "^spec-n-[a-z0-9-]+$"
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative path to a JS/TS module exporting a standard handler, invoked in-process via import()."
          },
          "priority": { "type": "integer", "default": 0 },
          "enabledByDefault": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "event", "entrypoint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "event": {
            "type": "string",
            "pattern": "^(before|after)_(?!update$)[a-z0-9][a-z0-9-]*$",
            "description": "Dynamic hook event: before_{stepId} or after_{stepId} for any registered workflow step ID. before_update and after_update are reserved and rejected. Unknown step IDs warn at manifest load and skip dispatch."
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative path to a JS/TS module exporting a standard handler, invoked in-process via import()."
          },
          "optional": { "type": "boolean", "default": true },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "workflowVariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Ordered step references; tier variants must list shared specify as step 1."
          }
        },
        "additionalProperties": false
      }
    },
    "agentSetup": {
      "type": "object",
      "description": "Agent integration block. Required for agent extensions; omitted for workflow-only extensions.",
      "required": ["mcpConfig"],
      "properties": {
        "mcpConfig": {
          "type": "object",
          "required": ["serverId", "format", "targets"],
          "properties": {
            "serverId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "Stable merge key for the Spec-N-Roll MCP server entry (default: spec-n-roll)."
            },
            "format": {
              "type": "string",
              "minLength": 1,
              "description": "MCP config format adapter id (e.g. cursor-mcp-json, claude-mcp-json)."
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Project-relative path to the agent's native MCP configuration file."
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "ruleTargets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Project-relative paths for generated rule pointer files."
        },
        "skillTargets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Project-relative paths for generated skill/command files."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
