{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-n-roll.local/contracts/workflow-config.schema.json",
  "title": "Spec-n-Roll Workflow Configuration",
  "type": "object",
  "required": ["schemaVersion", "toolkitVersion", "agents", "steps", "workflows", "defaultWorkflowId"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "toolkitVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "enabled", "commandPrefix"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" },
          "enabled": { "type": "boolean" },
          "commandPrefix": { "const": "spec-n-" },
          "ruleTargets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "skillTargets": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "command", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["built-in", "extension", "hook"]
          },
          "command": {
            "type": "string",
            "pattern": "^spec-n-[a-z0-9-]+$"
          },
          "implementation": { "type": "string" },
          "extensionId": { "type": "string" },
          "priority": { "type": "integer", "default": 0 },
          "enabled": { "type": "boolean" },
          "outputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Expected artifact paths for partial-step detection (built-in steps)."
          }
        },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Tier variants list shared specify as step 1 plus tier-specific tail."
          },
          "default": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "defaultWorkflowId": {
      "type": "string",
      "minLength": 1,
      "description": "Pre-selected tier in manual/override picker only; does not auto-run before specify."
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "manifestPath", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "manifestPath": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
