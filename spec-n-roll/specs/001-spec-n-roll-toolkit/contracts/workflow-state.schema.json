{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-n-roll.local/contracts/workflow-state.schema.json",
  "title": "Spec-n-Roll Workflow State",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskSpecId",
    "slug",
    "workflowVariantId",
    "lastCompletedStepId",
    "status",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "taskSpecId": {
      "type": "string",
      "pattern": "^[0-9]{3,}$",
      "description": "Numeric task spec ID only (e.g. 001). Slug is a separate required field."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1
    },
    "workflowVariantId": {
      "type": "string",
      "minLength": 1
    },
    "lastCompletedStepId": {
      "type": ["string", "null"]
    },
    "currentStepId": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": ["active", "paused", "complete"],
      "description": "Operational progress only. Lifecycle (Active/Complete/Locked) is in spec.md YAML frontmatter."
    },
    "interruptedArtifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional cache of partial artifact paths detected via step output manifest."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
