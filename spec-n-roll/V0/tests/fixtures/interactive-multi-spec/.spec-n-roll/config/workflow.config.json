{
  "schemaVersion": "1",
  "toolkitVersion": "0.1.0",
  "agents": [
    {
      "id": "codex",
      "enabled": true,
      "commandPrefix": "spec-n-"
    }
  ],
  "steps": [
    {
      "id": "specify",
      "kind": "built-in",
      "command": "spec-n-specify",
      "enabled": true,
      "outputs": ["spec.md"]
    },
    {
      "id": "plan",
      "kind": "built-in",
      "command": "spec-n-plan",
      "enabled": true,
      "outputs": ["plan.md"]
    },
    {
      "id": "tasks",
      "kind": "built-in",
      "command": "spec-n-tasks",
      "enabled": true,
      "outputs": ["tasks.md"]
    },
    {
      "id": "implement",
      "kind": "built-in",
      "command": "spec-n-implement",
      "enabled": true
    }
  ],
  "workflows": [
    {
      "id": "quick",
      "name": "Quick",
      "description": "Focused implementation path for small changes.",
      "steps": ["specify", "tasks", "implement"],
      "default": true
    },
    {
      "id": "full",
      "name": "Full",
      "description": "Complete planning path for larger changes.",
      "steps": ["specify", "plan", "tasks", "implement"]
    }
  ],
  "defaultWorkflowId": "quick"
}
