{
  "name": "spec-n-roll-runtime",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#runtime/*.js": "./src/*.ts",
    "#runtime/*": "./src/*.ts"
  },
  "bin": {
    "spec-n-roll-runtime": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "lint": "eslint .",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "spec-n-roll-api": "0.1.0",
    "tslog": "^4.9.3"
  },
  "devDependencies": {
    "spec-n-roll-test": "0.1.0"
  }
}
