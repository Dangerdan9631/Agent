{
    "name":  "spec-n-roll-workspace",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "bin":  {
                "spec-n-roll":  "./src/spec-n-roll/dist/index.js",
                "snr":  "./src/spec-n-roll/dist/index.js"
            },
    "engines":  {
                    "node":  "\u003e=22"
                },
    "workspaces":  [
                       "src/*"
                   ],
    "scripts":  {
                    "build":  "npm run build --workspace spec-n-roll-api \u0026\u0026 npm run build --workspace spec-n-roll-sdk \u0026\u0026 npm run build --workspace spec-n-roll-test \u0026\u0026 npm run build --workspace spec-n-roll-runtime \u0026\u0026 npm run build --workspace spec-n-roll-mcp \u0026\u0026 npm run build --workspace spec-n-roll-arch \u0026\u0026 npm run build --workspace spec-n-roll",
                    "lint":  "eslint . \u0026\u0026 prettier --check .",
                    "lint:fix":  "eslint . --fix \u0026\u0026 prettier --write .",
                    "test":  "vitest run",
                    "test:cucumber":  "cucumber-js src/spec-n-roll-test/test/features --import src/spec-n-roll-test/dist/cucumber/**/*.js",
                    "arch":  "npm run arch --workspace spec-n-roll-arch",
                    "arch-view":  "npm run view --workspace spec-n-roll-arch"
                },
    "devDependencies":  {
                            "@cucumber/cucumber":  "^11.2.0",
                            "@eslint/js":  "^9.22.0",
                            "@types/node":  "^22.13.10",
                            "dependency-cruiser":  "^16.10.4",
                            "eslint":  "^9.22.0",
                            "eslint-config-prettier":  "^10.1.1",
                            "prettier":  "^3.5.3",
                            "spec-n-roll":  "0.1.0",
                            "spec-n-roll-api":  "0.1.0",
                            "spec-n-roll-arch":  "0.1.0",
                            "spec-n-roll-mcp":  "0.1.0",
                            "spec-n-roll-runtime":  "0.1.0",
                            "spec-n-roll-sdk":  "0.1.0",
                            "spec-n-roll-test":  "0.1.0",
                            "tsarch":  "^5.4.1",
                            "tsup":  "^8.5.1",
                            "typescript":  "^5.8.2",
                            "typescript-eslint":  "^8.26.1",
                            "vitest":  "^3.0.9"
                        },
    "allowScripts":  {
                         "esbuild@0.27.7":  true
                     }
}
